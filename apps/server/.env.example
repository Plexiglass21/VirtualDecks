# Configure in the server process environment / deployment platform.
# This file is an example; it is NOT automatically loaded by the server.
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# All participants offline: room can be resumed for one hour
ROOM_EMPTY_TTL_MS=3600000
# Reassignment of disconnected host if another participant is online: 3 minutes
HOST_OFFLINE_GRACE_MS=180000
# Release offline participant seats while others are active: 20 minutes
OFFLINE_SEAT_TTL_MS=1200000
ROOM_CLEANUP_INTERVAL_MS=60000

# Private-beta guardrails (single Node.js process)
MAX_ROOMS=200
# Use exact HTTPS frontend origin(s) when deploying: CORS_ORIGINS=https://your-domain.example
# Use HTTPS/WSS and a reverse proxy with connection limits in production.

# R3.1: validated settings. Any invalid value stops the process at startup.
# Default HOST=0.0.0.0 keeps LAN development working. For local reverse proxy:
# HOST=127.0.0.1 (and block direct public traffic to port 3001).
HOST=0.0.0.0
MAX_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=32
CONNECTION_ATTEMPTS_PER_MINUTE=60
MAX_PACKET_BYTES=16384
MAX_RATE_LIMITER_KEYS=10000
SHUTDOWN_TIMEOUT_MS=8000
LOG_LEVEL=info
# Set REQUIRE_ORIGIN=true only if ALL Socket.IO clients send a permitted Origin.
REQUIRE_ORIGIN=false
# Only configure TRUSTED_PROXY_IPS when HOST is a specific IP (e.g. 127.0.0.1).
# The proxy must append/overwrite X-Forwarded-For, and direct backend access must be blocked.
# TRUSTED_PROXY_IPS=127.0.0.1
# Optional read-only aggregate metrics. Use a random 24+ char secret, never commit it.
# METRICS_TOKEN=generate-a-long-random-secret-on-your-server
